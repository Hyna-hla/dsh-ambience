{
  "name": "dsh-ambience",
  "version": "1.0.0",
  "description": "DSH 氛围插件：可自主淡化的自定义图片背景（JPG/PNG，不遮挡 UI）+ 背景音乐播放器（FLAC/MP3/WAV/M4A，音量 0-200%）+ 10 段专业均衡器（预设/预放大/旁路）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["slots", "theme"],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
